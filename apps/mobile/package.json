    "expo-linking": "57.0.9",
    "expo-notifications": "57.0.17",
    "expo-device": "57.0.1",
    "expo-font": "57.0.3",
    "expo-status-bar": "57.0.1",
    "@expo/metro-runtime": "57.0.15",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-webview": "13.16.1",
    "react-native-screens": "4.26.0",
