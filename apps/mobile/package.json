{
  "name": "@selery/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "npm run chart:bundle && expo start",
    "chart:bundle": "node scripts/bundle-chart.mjs",
