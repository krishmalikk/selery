# SELERY backend configuration. Use this as a checklist; do not overwrite an existing .env.
# Local API reads the repository-root .env. Set deployment values in Railway service variables.
# Provider keys, login password, session secret, notification credentials and LLM key are SERVER ONLY.
ALPACA_ENDPOINT=https://paper-api.alpaca.markets
ALPACA_KEY=your_alpaca_key
ALPACA_SECRET=your_alpaca_secret
SELERY_PASSWORD=choose-a-long-personal-password
SELERY_SESSION_SECRET=generate-at-least-32-random-characters
SELERY_DATA_MODE=fixtures
SELERY_DATABASE_URL=sqlite:///./data/selery.db
SELERY_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Full Docker Compose stack: replace the password before starting Compose.
SELERY_DB_PASSWORD=choose-a-separate-database-password
SELERY_REDIS_URL=redis://localhost:6379

# Next server only; set in apps/web/.env.local or the Vercel environment.
SELERY_API_URL=http://127.0.0.1:8000
# Public browser address; optional. Leave blank for 30-second polling.
NEXT_PUBLIC_SELERY_WS_URL=

# Public mobile configuration: pass in the shell, apps/mobile/.env.local, or EAS environments.
# A physical phone needs a LAN IP or public HTTPS backend, not localhost.
EXPO_PUBLIC_API_URL=http://localhost:8000
EXPO_PUBLIC_EAS_PROJECT_ID=
SELERY_IOS_BUNDLE_ID=com.selery.research
SELERY_ANDROID_PACKAGE=com.selery.research

# Optional research data providers. Blank means unavailable. They never replace Alpaca silently.
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
TWELVE_DATA_API_KEY=
FRED_API_KEY=
# Use an application name followed by your contact email when enabling SEC/feed requests.
SEC_USER_AGENT=
# Optional paid SDK adapters are not exposed by the default free-provider query route.
# Massive and Databento require additional explicit adapter/entitlement configuration; merely
# adding a key does not enable them. See SETUP-REQUIREMENTS.md.

# Read-only Anthropic assistant: all three conditions (enablement, key, positive cap) are required.
# Keep off and $0 until intentionally funded. Model changes require matching current prices.
SELERY_LLM_ENABLED=false
SELERY_LLM_MONTHLY_CAP_USD=0
ANTHROPIC_API_KEY=
SELERY_LLM_MODEL=claude-haiku-4-5-20251001
SELERY_LLM_INPUT_USD_PER_MILLION=1
SELERY_LLM_OUTPUT_USD_PER_MILLION=5

# Optional external alerts. Registering a device does not enable delivery.
SELERY_NOTIFICATIONS_ENABLED=false
EXPO_ACCESS_TOKEN=
SELERY_DISCORD_WEBHOOK=
SELERY_TELEGRAM_BOT_TOKEN=
SELERY_TELEGRAM_CHAT_ID=
SELERY_SMTP_HOST=
SELERY_SMTP_PORT=587
SELERY_SMTP_USER=
SELERY_SMTP_PASSWORD=
SELERY_SMTP_FROM=
SELERY_SMTP_TO=
SELERY_SMTP_TLS=starttls
